# Copy to .env.local and fill in. Never commit .env.local.

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase: Content Machine (catalog + sell-through data) ──
# Project ref: yujsblogikvyaxravcpx
CONTENT_MACHINE_SUPABASE_URL=https://yujsblogikvyaxravcpx.supabase.co
# Anon key is enough to read the catalog tables (RLS allow_all).
CONTENT_MACHINE_SUPABASE_ANON_KEY=
# Service-role key unlocks `part_valuations` (verified eBay valuations).
CONTENT_MACHINE_SUPABASE_SERVICE_ROLE_KEY=

# ── Oxylabs Web Scraper API (live eBay verification) ─────────────
# Username/password from the Oxylabs dashboard (realtime.oxylabs.io).
# Without them lookups use catalog data only.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
# Part types checked live per lookup (top N by catalog expected value).
# EBAY_VERIFY_TOP_N=12
# eBay gates sold-listing search (bot check); attempts are off by default
# because each blocked request burns ~60s of retries. Set to 1 to try.
# EBAY_SOLD_SEARCH=0

# ── LLM (vehicle profiles for scrap weight, generation expansion) ─
# Optional. Without a key Ferion falls back to cached rows + heuristics.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
